# BrajMitra AI - Supabase Environment Variables Template
# Copy this file to .env.local and populate with your project credentials from the Supabase dashboard.
# NEVER commit .env.local or real secrets to version control.

# Required: Public Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Required: Public Anonymous / Publishable Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Server-only service role key for backend admin / migration scripts (DO NOT prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
